{
  // Node 侧 TS(vite / vitest 配置与 scripts/ 发布脚本)的类型检查配置;运行用 `bun run typecheck:node`。
  // 根 tsconfig.json 通过 references 引用本文件,TS 要求被引用项目开启 composite 且不能设 noEmit,
  // 因此 noEmit 只在命令行传入;composite 隐含 incremental,把 tsbuildinfo 放进 node_modules 以免污染工作区。
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*.ts"]
}
